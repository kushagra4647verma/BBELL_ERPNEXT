  "html": "<style> \r\n    .text-size {\r\n        font-size: 12px !important;\r\n    }\r\n    .Upper_case{\r\n        text-transform: uppercase;\r\n    }\r\n    .capitalize{\r\n        text-transform: capitalize;\r\n    }\r\n    .underline{\r\n         text-decoration: underline;\r\n    }\r\n    .center{\r\n        text-align: center;\r\n    }\r\n    .left{\r\n        text-align: left !important;\r\n    }\r\n    .right{\r\n        text-align: right !important;\r\n    }\r\n    .bold{\r\n        font-weight: bold;\r\n    }\r\n</style>\r\n    <div id=\"header-html\" class=\"hidden-pdf\">\r\n        {% if letter_head and not no_letterhead %}\r\n            <div class=\"letter-head\">{{ letter_head }}</div>\r\n        {% endif %}\r\n    </div>\r\n    <div>\r\n        <h4 class=\"center\"> CERTIFICATE OF ANALYSIS</h4>\r\n    </div>\r\n    <p class=\"text-size capitalize left \" style=\"margin-left: 7px;\"><span class=\"bold\">name of product : </span>{{ doc.item_name or '' }}</p>\r\n\r\n    <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" class=\"tbspace\">\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <!--<p class=\"text-size capitalize left \"><span class=\"bold\">name of product : </span>{{ doc.item_name or '' }}</p>-->\r\n            </td>\r\n            <td width=\"50%\">\r\n                <!--<p class=\"text-size capitalize left\"><span class=\"bold\">strength :</span>  {{ doc.concentration or 0.00 }}%</p>-->\r\n            <td>\r\n        </tr>\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Lot No. </span>{{doc.lot_no or ''}}</p>\r\n                <!--{{ frappe.db.get_value(\"Outward Sample\",doc.reference_name,'lot_no') or ''}}-->\r\n            </td>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Sample Quantity:</span> {{ doc.sample_size or 0 }} {{ doc.sample_size_uom }}</p>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Lot Qty. </span>{% if doc.lot_qty %}{{doc.lot_qty or ''}} {{ doc.lot_qty_uom }}{% endif %}</p>\r\n                <!--{{ frappe.db.get_value(\"Outward Sample\",doc.reference_name,'lot_qty') or ''}}-->\r\n            </td>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Reference No:</span> {{ doc.reference_name or '' }}</p>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Party Name :</span>  {{ frappe.db.get_value(\"Outward Sample\",doc.reference_name,'party_name') or '' }}</p>\r\n                <!--<p class=\"text-size capitalize left\"><span class=\"bold\">C.A.S.No.</span>{{ frappe.db.get_value(\"Item\",doc.item_code,'cas_no') or '' }}</p>-->\r\n            </td>\r\n            <td width=\"50%\">\r\n                <p class=\"text-size capitalize left\"><span class=\"bold\">Date:</span>  {{ frappe.utils.formatdate(doc.get_formatted('report_date'), \"dd/MM/yyyy\") or '' }}</p>\r\n            </td>\r\n        </tr>\r\n        <!--<tr>-->\r\n        <!--    <td width=\"50%\">-->\r\n        <!--        <p class=\"text-size capitalize left\"><span class=\"bold\">Analysis Name :</span>  {{ doc.analysis_name or '' }}</p>-->\r\n        <!--    </td>-->\r\n        <!--    <td width=\"50%\">-->\r\n                \r\n        <!--    </td>-->\r\n        <!--</tr>-->\r\n    </table>\r\n     <h4 class=\"center\"> QUALITY DATA</h4>\r\n    <table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" class=\"tbspace\">\r\n        <tr>\r\n            <th>ANALYSIS</th>\r\n            <!--<th>Specification</th>-->\r\n            <th>Result</th>\r\n        </tr>\r\n        {% for row in doc.readings %}\r\n        <tr>\r\n            <td>\r\n                <p class=\"text-size\"> {{ row.specification or '' }}</p>\r\n            </td>\r\n            <!--<td>-->\r\n            <!--    <p class=\"text-size\">{{ row.value or '' }}</p>-->\r\n            <!--</td>-->\r\n            <td>\r\n                {% if row.reading_image %}\n                <img src=\"{{ row.reading_image }}\" style=\"max-width:200px; max-height:150px; display:block;\">\n                {% else %}\n                <p class=\"text-size\">{{ row.reading_1 or '' }}</p>\n                {% endif %}\r\n            </td>\r\n        </tr>\r\n        {% endfor %}\r\n\r\n    </table>\r\n    <br/>\r\n    <br/>\r\n    <br/>\r\n    <br/>\r\n    <br/>\r\n    <br/>\r\n    <!--<table width=\"100%\">-->\r\n    <!--    <tr>-->\r\n    <!--        <td width=\"50%\">-->\r\n    <!--            <p class=\"bold capitalize\">{{ frappe.get_fullname(doc.inspected_by) or \"\" }}</p>-->\r\n    <!--            <p class=\"bold Upper_case\">ANALYSES BY </p>-->\r\n    <!--        </td>-->\r\n    <!--        <td class=\"right\" width=\"50%\">-->\r\n    <!--            <p class=\"bold capitalize \">-->\r\n    <!--                {{ frappe.get_fullname(doc.verified_by) or \"\" }}</p>-->\r\n    <!--            <p class=\"bold Upper_case \">-->\r\n    <!--                CHECKED BY -->\r\n    <!--            </p>-->\r\n    <!--        </td>-->\r\n    <!--    </tr>-->\r\n    <!--</table>-->\r\n",
